---
const items = Astro.props.items ?? ['Unity', 'C#', 'Movement', '3C'];
const line = items.join(' · ') + ' · ';
---
<div class="marquee"><div class="marquee__in"><span>{line}</span></div></div>
<script>
  (() => {
    const track = document.querySelector('.marquee__in');
    if (!track) return;
    const span = track.firstElementChild;
    const total = span.offsetWidth;
    const need = Math.ceil((window.innerWidth * 2) / total);
    for (let i = 1; i < need; i++) {
      track.appendChild(span.cloneNode(true));
    }
    if (track.children.length % 2 !== 0) {
      track.appendChild(span.cloneNode(true));
    }
  })();
</script>
